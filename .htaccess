Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^(app|config|database)(/|$) - [F,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !\.php$ [NC]
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [QSA,L]
</IfModule>
